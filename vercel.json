{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/products",
      "destination": "/catalogue.html",
      "permanent": true
    },
    {
      "source": "/enquiry",
      "destination": "/enquiry.html",
      "permanent": true
    },
    {
      "source": "/payment",
      "destination": "/enquiry.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}